# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Tooling / caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# OS / editor
.DS_Store
Thumbs.db
.idea/
# Share the workspace launch/tasks/settings/extensions. Ignore other .vscode files.
# (.vscode/ as a directory rule cannot be re-included; ignore the contents instead.)
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/settings.json
!.vscode/extensions.json

# LCA runtime / secrets (Rule 23 — ห้าม commit secret เด็ดขาด)
# gitignore ไม่ตัดคอมเมนต์ท้ายบรรทัด — ถ้าเขียน path แล้วตามด้วย # มันจะไม่ match
# API keys ของ search provider ฯลฯ
config.json
config.json.tmp
# snapshot ของ config (เคยมี secret เต็ม — ห้าม commit, Rule 23)
config_versions.json
config_versions.json.tmp
# user/role/api-key store (มี hash — ถือเป็น secret)
org.json
# พื้นที่ส่วนตัว/บริษัท + ข้อความ (เนื้อหาส่วนตัว ไม่ commit)
spaces.json
todos.json
CHANGELOG_local.md
.local_coder_backup/
# SQLite stores (jobs.db ฯลฯ) — runtime data, ไม่ commit
*.db
*.sqlite3
# คิวงาน agent (รันไทม์ ไม่ commit)
agent_jobs.json
agent_jobs.json.tmp
agent_queue.txt
agent_approvals.json
agent_approvals.json.tmp
# ต่อสมอง AI ภายนอก (มี api_key — secret, Rule 23)
connections.json
connections.json.tmp
# API keys at rest (DPAPI blob on Windows, mode 0600 elsewhere)
secrets.bin
secrets.bin.tmp
# ทะเบียน node ของคลัสเตอร์ — state ในเครื่อง ไม่ใช่ซอร์ส
cluster.json
# marker ยืนยันโฟลเดอร์ (folder_trust.py) — state ในเครื่อง
.lca_trust
# export บทสนทนาสำหรับ fine-tune (อาจมี prompt/response)
lca_dataset.jsonl
# STORAGE_ROOT เริ่มต้นของ storage_backend (state ในเครื่อง)
data/
# นิยาม Skills / Bots (รันไทม์ ไม่ commit)
skills.json
skills.json.tmp
bots.json
bots.json.tmp
# sandbox ของ bot-agent (ไฟล์ที่ agent อ่าน/เขียน — ไม่ commit)
agent_workspace/
