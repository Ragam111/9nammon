# Copy to .env and change the passwords. Avoid single quotes (') in passwords.
POSTGRES_PASSWORD=change-me-admin
LCA_APP_PASSWORD=change-me-app

# 8 GB RAM / CPU-only PC: start small, then benchmark bigger models (see p.txt)
LCA_MODEL=qwen2.5-coder:1.5b
LCA_NUM_CTX=4096

# Ollama running natively on the host (recommended on 8 GB):
OLLAMA_URL=http://host.docker.internal:11434
# Ollama inside compose instead (docker compose --profile ollama up -d):
# OLLAMA_URL=http://ollama:11434
