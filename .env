POSTGRES_PASSWORD=change-me
LCA_APP_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://lca_app:change-me@postgres:5432/lca
OLLAMA_URL=http://ollama:11434

# โมเดลหลัก (3b เหมาะสุดสำหรับเขียนโค้ดบน RAM 8GB)
LCA_MODEL=qwen2.5-coder:3b

# รายชื่อโมเดลทั้งหมดที่มีในเครื่อง (ตรงตาม ollama list)
LCA_AVAILABLE_MODELS=qwen2.5-coder:3b,gemma4:e2b,llama3:8b,qwen2.5:1.5b,qwen3.5:0.8b
LCA_CHAT_MODEL=gemma4:e2b
LCA_HEAVY_MODEL=llama3:8b
LCA_FAST_MODEL=qwen2.5:1.5b

# คุมเพดาน RAM และ KV Cache (เซฟเครื่อง 8GB ไม่ให้ค้าง)
LCA_NUM_CTX=2048
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_KEEP_ALIVE=3m
OLLAMA_FLASH_ATTENTION=1
