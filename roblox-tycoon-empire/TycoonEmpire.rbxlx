					<Properties>
						<string name="Name">MiningFloor</string>
						<Vector3 name="size"><X>60</X><Y>1</Y><Z>60</Z></Vector3>
						<CoordinateFrame name="CFrame"><X>0</X><Y>0.5</Y><Z>-120</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame>
						<Color3 name="Color3uint8"><R>140</R><G>130</G><B>120</B></Color3>
						<bool name="Anchored">true</bool>
						<token name="Material">16</token>
					</Properties>
				</Item>
				<!-- Clickable rocks -->
				<Item class="Part" referent="Rock1">
					<Properties>
						<string name="Name">Rock</string>
						<Vector3 name="size"><X>4</X><Y>4</Y><Z>4</Z></Vector3>
						<CoordinateFrame name="CFrame"><X>-10</X><Y>3</Y><Z>-120</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame>
						<Color3 name="Color3uint8"><R>120</R><G>120</G><B>120</B></Color3>
						<bool name="Anchored">true</bool>
						<token name="Material">16</token>
					</Properties>
					<Item class="ClickDetector"><Properties><string name="Name">ClickDetector</string></Properties></Item>
					<Item class="Script">
						<Properties>
							<string name="Name">MineScript</string>
							<ProtectedString name="Source"><![CDATA[
local rock = script.Parent
local cd = rock:FindFirstChild("ClickDetector")
local health = 5
local maxHealth = 5
local reward = 10

cd.MouseClick:Connect(function(player)
	health = health - 1
	rock.Transparency = (maxHealth - health) / maxHealth * 0.8
	if health <= 0 then
		player.leaderstats.Cash.Value = player.leaderstats.Cash.Value + reward
		rock.Transparency = 1
		rock.CanCollide = false
		wait(30)
		health = maxHealth
		rock.Transparency = 0
		rock.CanCollide = true
	end
end)
]]></ProtectedString>
						</Properties>
					</Item>
				</Item>
			</Item>

