<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
	<External>null</External>
	<External>nil</External>

	<!-- ===== ServerScriptService ===== -->
	<Item class="ServerScriptService" referent="SSS">
		<Properties>
			<string name="Name">ServerScriptService</string>
		</Properties>

		<!-- Leaderstats -->
		<Item class="Script" referent="LeaderstatsScript">
			<Properties>
				<string name="Name">LeaderstatsScript</string>
				<ProtectedString name="Source"><![CDATA[
game.Players.PlayerAdded:Connect(function(player)
	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	leaderstats.Parent = player

	local cash = Instance.new("IntValue")
	cash.Name = "Cash"
	cash.Value = 100
	cash.Parent = leaderstats

	local rebirth = Instance.new("IntValue")
	rebirth.Name = "Rebirth"
	rebirth.Value = 0
	rebirth.Parent = leaderstats
end)
]]></ProtectedString>
			</Properties>
		</Item>

		<!-- DataStore Save/Load -->
		<Item class="Script" referent="DataStoreScript">
			<Properties>
				<string name="Name">DataStoreScript</string>
				<ProtectedString name="Source"><![CDATA[
local DSS = game:GetService("DataStoreService")
local store = DSS:GetDataStore("PlayerData_v1")

game.Players.PlayerAdded:Connect(function(player)
	local key = "Player_" .. player.UserId
	local success, data = pcall(function()
		return store:GetAsync(key)
	end)
	if success and data then
		player.leaderstats.Cash.Value = data.Cash or 0
		player.leaderstats.Rebirth.Value = data.Rebirth or 0
	end
end)

game.Players.PlayerRemoving:Connect(function(player)
	local key = "Player_" .. player.UserId
	pcall(function()
		store:SetAsync(key, {
			Cash = player.leaderstats.Cash.Value,
			Rebirth = player.leaderstats.Rebirth.Value,
		})
	end)
end)

game:BindToClose(function()
	for _, player in ipairs(game.Players:GetPlayers()) do
		local key = "Player_" .. player.UserId
		pcall(function()
			store:SetAsync(key, {
				Cash = player.leaderstats.Cash.Value,
				Rebirth = player.leaderstats.Rebirth.Value,
			})
		end)
	end
end)
]]></ProtectedString>
			</Properties>
		</Item>

		<!-- Rebirth System -->
		<Item class="Script" referent="RebirthScript">
			<Properties>
				<string name="Name">RebirthScript</string>
				<ProtectedString name="Source"><![CDATA[
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local rebirthEvent = Instance.new("RemoteEvent")
rebirthEvent.Name = "RebirthEvent"
rebirthEvent.Parent = ReplicatedStorage

local REBIRTH_COST = 10000

rebirthEvent.OnServerEvent:Connect(function(player)
	local cash = player.leaderstats.Cash
	local rebirth = player.leaderstats.Rebirth
	if cash.Value >= REBIRTH_COST then
		rebirth.Value = rebirth.Value + 1
		cash.Value = 100
	end
end)
]]></ProtectedString>
			</Properties>
		</Item>

		<!-- Tycoon Setup (assigns plots to players) -->
		<Item class="Script" referent="TycoonSetup">
			<Properties>
				<string name="Name">TycoonSetupScript</string>
				<ProtectedString name="Source"><![CDATA[
local plots = workspace.Zones.StarterPlots:GetChildren()
local assignedPlots = {}

game.Players.PlayerAdded:Connect(function(player)
	for _, plot in ipairs(plots) do
		if not assignedPlots[plot] then
			assignedPlots[plot] = player.Name
			local owner = plot:FindFirstChild("Owner")
			if owner then
				owner.Value = player.Name
			end
			-- Set spawn
			local spawn = plot:FindFirstChild("SpawnLocation")
			if spawn then
				player.RespawnLocation = spawn
			end
			break
		end
	end
end)

game.Players.PlayerRemoving:Connect(function(player)
	for plot, name in pairs(assignedPlots) do
		if name == player.Name then
			assignedPlots[plot] = nil
			local owner = plot:FindFirstChild("Owner")
			if owner then
				owner.Value = ""
			end
		end
	end
end)
]]></ProtectedString>
			</Properties>
		</Item>
	</Item>

