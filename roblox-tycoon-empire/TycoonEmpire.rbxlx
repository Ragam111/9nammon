							</Properties>
						</Item>
						<Item class="Script" referent="Plot1DropperScript">
							<Properties>
								<string name="Name">DropperScript</string>
								<ProtectedString name="Source"><![CDATA[
local dropper = script.Parent
local dropPart = dropper:FindFirstChild("DropPart")

while true do
	wait(2)
	local item = Instance.new("Part")
	item.Size = Vector3.new(1, 1, 1)
	item.BrickColor = BrickColor.new("Gold")
	item.Position = dropPart.Position - Vector3.new(0, 2, 0)
	item.Parent = workspace

	local val = Instance.new("IntValue")
	val.Name = "Value"
	val.Value = 5
	val.Parent = item

	game.Debris:AddItem(item, 15)
end
]]></ProtectedString>
							</Properties>
						</Item>
					</Item>

					<!-- Conveyor Belt -->
					<Item class="Part" referent="Plot1Conveyor">
						<Properties>
							<string name="Name">ConveyorBelt</string>
							<Vector3 name="size"><X>4</X><Y>1</Y><Z>12</Z></Vector3>
							<CoordinateFrame name="CFrame"><X>-80</X><Y>1</Y><Z>-80</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame>
							<Color3 name="Color3uint8"><R>50</R><G>50</G><B>50</B></Color3>
							<bool name="Anchored">true</bool>
						</Properties>
						<Item class="Script" referent="Plot1ConveyorScript">
							<Properties>
								<string name="Name">ConveyorScript</string>
								<ProtectedString name="Source"><![CDATA[
local conveyor = script.Parent
local speed = 10

conveyor.Touched:Connect(function(hit)
	if hit:FindFirstChild("Value") then
		hit.Velocity = conveyor.CFrame.LookVector * speed
	end
end)
]]></ProtectedString>
							</Properties>
						</Item>
					</Item>

					<!-- Upgrader -->
					<Item class="Part" referent="Plot1Upgrader">
						<Properties>
							<string name="Name">Upgrader</string>
							<Vector3 name="size"><X>4</X><Y>3</Y><Z>4</Z></Vector3>
							<CoordinateFrame name="CFrame"><X>-75</X><Y>2</Y><Z>-80</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame>
							<Color3 name="Color3uint8"><R>255</R><G>165</G><B>0</B></Color3>
							<bool name="Anchored">true</bool>
							<float name="Transparency">0.3</float>
						</Properties>
						<Item class="Script" referent="Plot1UpgraderScript">
							<Properties>
								<string name="Name">UpgraderScript</string>
								<ProtectedString name="Source"><![CDATA[
local upgrader = script.Parent
local multiplier = 1.5
local debounce = {}

upgrader.Touched:Connect(function(hit)
	local val = hit:FindFirstChild("Value")
	if val and not debounce[hit] then
		debounce[hit] = true
		val.Value = math.floor(val.Value * multiplier)
		hit.BrickColor = BrickColor.new("Bright orange")
		wait(0.5)
		debounce[hit] = nil
	end
end)
]]></ProtectedString>
							</Properties>
						</Item>
					</Item>

					<!-- Collector -->
					<Item class="Part" referent="Plot1Collector">
						<Properties>
							<string name="Name">Collector</string>
							<Vector3 name="size"><X>4</X><Y>4</Y><Z>4</Z></Vector3>
							<CoordinateFrame name="CFrame"><X>-70</X><Y>2</Y><Z>-80</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame>
							<Color3 name="Color3uint8"><R>0</R><G>200</G><B>0</B></Color3>
							<bool name="Anchored">true</bool>
						</Properties>
						<Item class="StringValue" referent="Plot1CollectorOwner">
							<Properties>
								<string name="Name">Owner</string>
								<string name="Value"></string>
							</Properties>
						</Item>
						<Item class="Script" referent="Plot1CollectorScript">
							<Properties>
								<string name="Name">CollectorScript</string>
								<ProtectedString name="Source"><![CDATA[
local collector = script.Parent
local ownerValue = collector:FindFirstChild("Owner")

collector.Touched:Connect(function(hit)
	local val = hit:FindFirstChild("Value")
	if val then
		local ownerName = ownerValue.Value
		local player = game.Players:FindFirstChild(ownerName)
		if player then
			player.leaderstats.Cash.Value = player.leaderstats.Cash.Value + val.Value
		end
		hit:Destroy()
	end
end)
]]></ProtectedString>
							</Properties>
						</Item>
					</Item>

					<!-- Buy Button (Upgrader Level 2) -->
					<Item class="Part" referent="Plot1Button">
						<Properties>
							<string name="Name">BuyUpgraderLv2</string>
							<Vector3 name="size"><X>4</X><Y>0.5</Y><Z>4</Z></Vector3>
							<CoordinateFrame name="CFrame"><X>-85</X><Y>0.25</Y><Z>-72</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame>
							<Color3 name="Color3uint8"><R>255</R><G>255</G><B>0</B></Color3>
							<bool name="Anchored">true</bool>
						</Properties>
						<Item class="IntValue" referent="Plot1BtnPrice">
							<Properties>
								<string name="Name">Price</string>
								<int name="Value">500</int>
							</Properties>
						</Item>
						<Item class="StringValue" referent="Plot1BtnItem">
							<Properties>
								<string name="Name">ItemName</string>
								<string name="Value">UpgraderLv2</string>
							</Properties>
						</Item>
						<Item class="Script" referent="Plot1ButtonScript">
							<Properties>
								<string name="Name">ButtonScript</string>
								<ProtectedString name="Source"><![CDATA[
local button = script.Parent
local price = button:FindFirstChild("Price").Value
local itemToUnlock = button:FindFirstChild("ItemName").Value
local debounce = false

button.Touched:Connect(function(hit)
	if debounce then return end
	local player = game.Players:GetPlayerFromCharacter(hit.Parent)
	if not player then return end
	if player.leaderstats.Cash.Value >= price then
		debounce = true
		player.leaderstats.Cash.Value = player.leaderstats.Cash.Value - price
		local model = workspace.HiddenItems:FindFirstChild(itemToUnlock)
		if model then
			model.Transparency = 0
			model.CanCollide = true
		end
		button:Destroy()
	end
end)
]]></ProtectedString>
							</Properties>
						</Item>
					</Item>
				</Item>

