	<!-- ===== StarterPlayerScripts ===== -->
	<Item class="StarterPlayer" referent="SP">
		<Properties>
			<string name="Name">StarterPlayer</string>
		</Properties>
		<Item class="StarterPlayerScripts" referent="SPS">
			<Properties>
				<string name="Name">StarterPlayerScripts</string>
			</Properties>
			<Item class="LocalScript" referent="CashUIScript">
				<Properties>
					<string name="Name">CashUIScript</string>
					<ProtectedString name="Source"><![CDATA[
local player = game.Players.LocalPlayer
local gui = player.PlayerGui:WaitForChild("CashGui")
local cashLabel = gui:WaitForChild("CashLabel")
local rebirthBtn = gui:WaitForChild("RebirthButton")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local leaderstats = player:WaitForChild("leaderstats")
local cash = leaderstats:WaitForChild("Cash")
local rebirth = leaderstats:WaitForChild("Rebirth")

local function updateUI()
	cashLabel.Text = string.format("Cash: $%s | Rebirth: %d", tostring(cash.Value), rebirth.Value)
end

cash.Changed:Connect(updateUI)
rebirth.Changed:Connect(updateUI)
updateUI()

rebirthBtn.MouseButton1Click:Connect(function()
	local rebirthEvent = ReplicatedStorage:WaitForChild("RebirthEvent")
	rebirthEvent:FireServer()
end)
]]></ProtectedString>
				</Properties>
			</Item>
		</Item>
	</Item>

