					<UDim2 name="Size"><XS>0</XS><XO>250</XO><YS>0</YS><YO>40</YO></UDim2>
					<string name="Text">Rebirth ($10,000)</string>
					<float name="TextSize">20</float>
					<Color3 name="TextColor3"><R>1</R><G>1</G><B>1</B></Color3>
