					<!-- Dropper -->
					<Item class="Model" referent="Plot1Dropper">
						<Properties>
							<string name="Name">Dropper</string>
						</Properties>
						<Item class="Part" referent="Plot1DropPart">
							<Properties>
								<string name="Name">DropPart</string>
								<Vector3 name="size"><X>4</X><Y>4</Y><Z>4</Z></Vector3>
								<CoordinateFrame name="CFrame"><X>-90</X><Y>5</Y><Z>-80</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame>
								<Color3 name="Color3uint8"><R>100</R><G>100</G><B>100</B></Color3>
