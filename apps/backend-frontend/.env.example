# backend-frontend: copy to backend/.env (or point ENV_FILE at it) and fill in.
# .env files are git-ignored. Never commit real keys or secrets.
# Real environment variables always win over values in this file.

# --- Where the API listens and what the browser may call -------------------
# Public address the server uses to build links (OAuth redirect, etc.).
# Local dev: http://127.0.0.1:8010. LAN test: http://<your LAN IP>:8010.
PUBLIC_BASE_URL=http://127.0.0.1:8010
# Comma-separated origins the browser may call from. Add the UI origin.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to true only when the site is served over HTTPS.
COOKIE_SECURE=false
# Proxy addresses allowed to set X-Real-IP (for example a reverse proxy in Docker).
TRUSTED_PROXY_CIDRS=

# --- Data ----------------------------------------------------------------
# Folder for app.db (SQLite). Relative paths are relative to the backend folder.
DATA_DIR=data-dev

# --- Local models (Ollama on this machine) ---------------------------------
# Off by default. Set true to list and use local models (127.0.0.1:11434 only).
LOCAL_MODELS_ENABLED=false

# --- Cloud model providers (keys are secrets; leave empty to disable) ------
CHAT_OPENAI_API_KEY=
CHAT_OPENAI_BASE_URL=https://api.openai.com/v1
CHAT_OPENAI_MODELS=gpt-4o-mini
CHAT_GEMINI_API_KEY=
CHAT_GEMINI_MODELS=gemini-2.5-flash
CHAT_ANTHROPIC_API_KEY=
CHAT_ANTHROPIC_MODELS=claude-haiku-4-5

# --- Single OpenAI-compatible model used by /api/run ----------------------
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=

# --- Sign-in with Google or GitHub (optional; the button appears only when set)
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# --- Sessions, limits and quotas (tokens per window) ----------------------
SESSION_TTL_HOURS=
LOGIN_PER_IP_PER_MIN=
LOGIN_PER_USER_PER_MIN=
RATE_LIMIT_IP_PER_MIN=
RATE_LIMIT_USER_PER_MIN=
QUOTA_TOKENS_PER_WINDOW=
QUOTA_TOKENS_WEEKLY=
QUOTA_TOKENS_HEAVY_WEEKLY=
MAX_INPUT_CHARS=
MAX_OUTPUT_TOKENS=
