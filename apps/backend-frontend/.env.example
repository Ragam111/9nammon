# Copy to .env and fill in. Never commit .env. The model key is read only on the server.

# --- Model (OpenAI-compatible /chat/completions) ---
# Example local Ollama: http://127.0.0.1:11434/v1  (no key needed for localhost)
MODEL_BASE_URL=http://127.0.0.1:11434/v1
MODEL_NAME=qwen2.5-coder:1.5b
# Server-side only. Leave empty to set it once through the onboarding screen instead.
MODEL_API_KEY=
MODEL_TIMEOUT_S=60
MODEL_MAX_RETRIES=2
RETRY_BASE_DELAY_S=0.5

# --- Limits ---
MAX_INPUT_CHARS=8000
MAX_OUTPUT_TOKENS=1024
QUOTA_TOKENS_PER_DAY=50000
RATE_LIMIT_USER_PER_MIN=20
RATE_LIMIT_IP_PER_MIN=60
# Login attempts per IP and per username, per minute
LOGIN_PER_IP_PER_MIN=10
LOGIN_PER_USER_PER_MIN=5
# Approximate cost per 1,000 tokens, for the cost_estimate field in logs (0 = not tracked)
COST_PER_1K_TOKENS=0

# --- Server ---
DATA_DIR=./data
SESSION_TTL_HOURS=24
# Set to true when served over HTTPS
COOKIE_SECURE=false
# Proxies whose X-Real-IP is trusted for rate limits (comma-separated CIDRs). Leave empty unless a proxy sits in front.
TRUSTED_PROXY_CIDRS=
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
