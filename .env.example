# Copy to .env and change both passwords before `docker compose up -d --build`.
# .env is git-ignored; never commit real passwords.

# Postgres superuser (only used by initdb and admin tasks)
POSTGRES_PASSWORD=change-me-postgres

# Password for the least-privilege app role `lca_app` (set by initdb/10-app-password.sh)
LCA_APP_PASSWORD=change-me-app

# Optional overrides (defaults shown)
# LCA_API_PORT=8001            # host port for the API (bound to 127.0.0.1)
# OLLAMA_URL=http://host.docker.internal:11434
# LCA_MODEL=qwen2.5-coder:1.5b
# LCA_NUM_CTX=4096
