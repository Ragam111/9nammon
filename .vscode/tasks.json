{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "test: all (CI parity)",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-m", "unittest", "discover", "-s", "tests"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "test: current file",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-m", "pytest", "-q", "${file}"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "lint: ruff",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-m", "ruff", "check", "."],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "check: lint + tests",
      "dependsOrder": "sequence",
      "dependsOn": ["lint: ruff", "test: all (CI parity)"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "run: server :8420",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["server.py", "${workspaceFolder}", "--host", "127.0.0.1", "--port", "8420"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PORT": "",
          "LCA_HOST": ""
        }
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "lca-server",
        "pattern": {
          "regexp": "^.*$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Local Assistant Server",
          "endsPattern": "http://"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "version smoke",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["server.py", "--version"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
